# /etc/dictation/env
# systemd EnvironmentFile: 只写 KEY=VALUE，不要写 export。
# chmod 600 /etc/dictation/env

# TTS 的默认 provider（服务端生成时使用；serve 启动即读取）
DICTATION_PROVIDER=doubao

# 火山引擎豆包 TTS V3
DOUBAO_API_KEY=
DOUBAO_RESOURCE_ID=seed-tts-2.0
DOUBAO_VOICE_ZH=zh_female_vv_uranus_bigtts
DOUBAO_VOICE_EN=en_female_stokie_uranus_bigtts
# DOUBAO_MODEL=seed-tts-2.0-standard   # 仅复刻音色

# 百炼 Qwen-TTS（可选）
# DASHSCOPE_API_KEY=
# QWEN_TTS_MODEL=qwen3-tts-flash
# QWEN_VOICE_ZH=Cherry
# QWEN_VOICE_EN=Aiden

# 可选：保护写操作（POST /api/lessons、generate、cancel）
# 设置后写请求必须带 X-Dictation-Token；GET 不受影响。
# DICTATION_API_TOKEN=

# 可选
# DICTATION_CACHE_DIR=/srv/dictation/cache
# RUST_LOG=info
