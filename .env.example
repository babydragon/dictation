# 复制为 .env 后填入（不要提交 .env）
# 项目默认不自动读取 .env；可在 shell 中 source，或用 direnv。

# 百炼 Qwen-TTS（默认 provider）
DASHSCOPE_API_KEY=
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_VOICE_ZH=Cherry
QWEN_VOICE_EN=Aiden

# 火山引擎豆包 TTS V3（seed-tts-2.0）
DOUBAO_API_KEY=
DOUBAO_RESOURCE_ID=seed-tts-2.0
DOUBAO_VOICE_ZH=zh_female_vv_uranus_bigtts
DOUBAO_VOICE_EN=en_female_stokie_uranus_bigtts
# DOUBAO_MODEL=seed-tts-2.0-standard   # 仅复刻音色时需要

# 可选
# DICTATION_PROVIDER=doubao
# DICTATION_CACHE_DIR=cache
# RUST_LOG=info
